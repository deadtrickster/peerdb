--- a/flow/connectors/postgres/pgdump_schema.go
+++ b/flow/connectors/postgres/pgdump_schema.go
@@ -229,6 +229,16 @@
 		filterErr = <-filterDone
 	}
 
+	// A cancelled context is the CAUSE and the killed children are its symptom: name the
+	// cancellation, rather than whichever peer happened to die first. Nothing here called
+	// Kill() in that case (exec's Cancel did), so the agency guards below cannot see it.
+	// Precedence, when a real failure and a cancellation are both present, is a policy call:
+	// this reports the cancellation, and a caller that would rather see the peer failure can
+	// check ctx.Err() itself, since both are now distinguishable.
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		return fmt.Errorf("pipeline cancelled: %w", ctxErr)
+	}
+
 	// Report the original cause, not the side we killed in response.
 	if dstErr != nil && !dstKilled {
 		return fmt.Errorf("%s failed: %w\nstderr:\n%s", dstName, dstErr, dstStderr.String())
@@ -239,11 +249,14 @@
 	if filterErr != nil {
 		return fmt.Errorf("filter failed: %w", filterErr)
 	}
-	// Fallback: both sides killed (e.g. ctx cancel) — surface whichever error we have.
-	if srcErr != nil {
+	// Fallback: both sides killed (e.g. ctx cancel) — surface whichever error we have,
+	// but never a side this function killed on purpose. Killing src because dst is already
+	// gone is not a failure of src, and reporting it as one is what produced a flaky
+	// "src failed: signal: killed" whose rate depended on the scheduler.
+	if srcErr != nil && !srcKilled {
 		return fmt.Errorf("%s failed: %w\nstderr:\n%s", srcName, srcErr, srcStderr.String())
 	}
-	if dstErr != nil {
+	if dstErr != nil && !dstKilled {
 		return fmt.Errorf("%s failed: %w\nstderr:\n%s", dstName, dstErr, dstStderr.String())
 	}
 	return nil
